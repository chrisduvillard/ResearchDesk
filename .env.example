# Copy to .env for Docker Compose. Keep your local .env out of Git.
# This directory must exist and be writable by APP_UID / APP_GID.
# Relative paths are resolved from the directory containing compose.yaml.
HOST_DATA_DIR=./data

# The app always binds to 127.0.0.1 on the host.
APP_PORT=8765

# Container timezone; collection schedules always follow America/New_York.
APP_TIMEZONE=UTC

# Defaults are 1000:1000. The macOS/Linux setup appends your current IDs.
# APP_UID=1000
# APP_GID=1000

# HTTP localhost only. Set 1 for private HTTPS access through a reverse proxy.
APP_SECURE_COOKIES=0
# Optional exact browser origin for proxy deployments; no trailing slash.
APP_ORIGIN=
